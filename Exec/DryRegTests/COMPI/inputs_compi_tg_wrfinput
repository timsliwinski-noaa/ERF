# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_steps = 100

# PROBLEM SIZE & GEOMETRY
# geometry.prob_extent = 6.283185307179586    6.283185307179586    3.141592653589793    
geometry.prob_lo = 0 0 0
geometry.prob_hi = 6.283185307179586    6.283185307179586    3.141592653589793
amr.n_cell           = 256     256     128
geometry.is_periodic = 1 1 1  # periodic for all boundaries

# TIME STEP CONTROL
erf.fixed_dt           = 1e-3    # fixed time step = 0.001 seconds
erf.substepping_type   = "None"

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp
erf.der_data_log   = "diag_256x256x128.txt"

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk     # root name of checkpoint file
erf.check_int       = 100     # number of timesteps between checkpoints

# PLOTFILES
erf.plotfile_type   = "netcdf" # output amrex or netcdf files
erf.plot_file_1     = plt     # prefix of plotfile name
erf.plot_int_1      = 10      # number of timesteps between plotfiles
erf.plot_vars_1     = density rhoadv_0 x_velocity y_velocity z_velocity pressure temp theta scalar

# SOLVER CHOICE
erf.use_gravity = false
erf.use_coriolis = false
erf.use_pdvwork = true

erf.les_type          = "None"
erf.molec_diff_type   = "ConstantAlpha"
erf.dynamic_viscosity = 4e-3
erf.alpha_T = 0.0                       
erf.alpha_C = 0.0                       
erf.Pr_t = 1e25         #1e6            

# INITIALIZATION
erf.init_type = "wrfinput"
erf.use_real_bcs = false
erf.nc_init_file_0 = "wrfinput_TaylorGreen_256x256x128.nc"

#erf.terrain_type = "StaticFittedMesh"
#erf.moisture_model = "Kessler"
erf.terrain_type = "None"
erf.moisture_model = "None"
